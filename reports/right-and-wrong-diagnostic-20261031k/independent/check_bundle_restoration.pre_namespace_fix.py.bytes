"""Independent new-K-only recovery check; emits no private storage locators."""
import argparse,datetime,hashlib,json,zipfile
from pathlib import Path
HERE=Path(__file__).resolve().parent
def read(p):return json.loads(p.read_bytes())
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def main():
    ap=argparse.ArgumentParser();ap.add_argument('--private-root',type=Path,required=True);a=ap.parse_args();prep=a.private_root/'right-wrong-20261031k-derived-recovery-v1';fresh=a.private_root/'right-wrong-20261031k-restoration-v1';original=prep/'K_DERIVED_EVIDENCE_V1.zip';download=fresh/'K_DERIVED_EVIDENCE_V1.zip';manifest=read(prep/'PRIVATE_BUNDLE_MANIFEST.json');local=read(prep/'LOCAL_PREPARATION_RECEIPT.json');restore=read(fresh/'RESTORATION_RECEIPT.json');reference=read(prep/'PRIVATE_UPLOAD_AND_DOWNLOAD_REFERENCE.json');folder=read(a.private_root/'right-wrong-20261031k-recovery-metadata/folder.json');profile=read(a.private_root/'right-wrong-20261031k-recovery-metadata/profile.json');priorprofile=read(a.private_root/'point-prop-diagnostic-20261031i-recovery-metadata/profile.json')
    digest=sha(download);assert digest==sha(original)==local['archive_sha256']==restore['download_sha256']=='f7c7b1fbef43131e7950a5c08bec2819aa94626a4c264dda81e0c022224a0f3b';assert download.stat().st_size==original.stat().st_size==local['archive_bytes']==restore['download_bytes']==5362879;assert not download.samefile(original);assert restore['HTTP_status']==200 and restore['whole_archive_equal']is True and restore['all_inner_bytes_equal_to_original']is True and restore['global_old_recovery_gate_cleared']is False and local['old_global_recovery_gate_cleared']is False
    expected={'K-A-ROWS-EXAMPLES-V1','K-A-COVERAGE-ANNOTATIONS-V1','K-A-EVIDENCE-ANNOTATIONS-V1','K-B-NORMALIZED-INPUT-V1','K-B-ROWS-EXAMPLES-V1','K-B-COVERAGE-ANNOTATIONS-V1','K-B-EVIDENCE-ANNOTATIONS-V1','K-RR-NORMALIZED-INPUT-V1','K-RR-ROWS-EXAMPLES-V1','K-RR-EVIDENCE-ANNOTATIONS-V1'};assert{r['artifact_id']for r in manifest['members']}==expected and len(manifest['members'])==10;proof=[]
    with zipfile.ZipFile(download)as z:
        names=z.namelist();assert len(names)==len(set(names))==11 and z.testzip()is None;assert set(names)=={r['archive_member']for r in manifest['members']}|{'PRIVATE_BUNDLE_MANIFEST.json'};assert z.read('PRIVATE_BUNDLE_MANIFEST.json')==(prep/'PRIVATE_BUNDLE_MANIFEST.json').read_bytes()
        for r in manifest['members']:
            member=Path(r['archive_member']);relative=Path(r['source_relative_member']);assert not member.is_absolute()and'..'not in member.parts and not relative.is_absolute()and'..'not in relative.parts;source=a.private_root/relative;blob=z.read(r['archive_member']);assert hashlib.sha256(blob).hexdigest()==r['sha256']==sha(source)and len(blob)==r['bytes']==source.stat().st_size;proof.append(dict(artifact_id=r['artifact_id'],bytes=r['bytes'],sha256=r['sha256'],fresh_archive_member_and_original_equal=True))
    upload,metadata,ref=reference['upload'],reference['metadata'],reference['download_ref'];assert upload['success']is True and upload['id']==metadata['id']==ref['file_id'];assert folder['id']==upload['parent_id']and folder['id']in metadata['parent_ids'];assert metadata['shared']is False and folder['shared']is False;assert metadata['size']is None or int(metadata['size'])==5362879;assert all(p.get('type')=='user'for p in metadata['permissions']);owner=lambda x:{p.get('emailAddress')for p in x['permissions']if p.get('role')=='owner'};assert len(owner(metadata))==1 and owner(metadata)==owner(folder);assert profile['id']==priorprofile['id']and profile['email']==priorprofile['email'];profile_matches_owner=profile['email']in owner(metadata)
    out=dict(state='PASS_FRESH_NEW_K_BUNDLE_ONLY_WHOLE_AND_ALL_INNER_BYTES',artifact_id=manifest['artifact_id'],archive_sha256=digest,archive_bytes=5362879,scientific_members_verified=10,manifest_member_verified=True,archive_CRC_verified=True,whole_download_equal_to_original=True,all_inner_bytes_equal_to_all10_original_files=True,original_files_preserved=True,original_and_restored_copies_distinct=True,member_proofs=proof,private_reference_receipt_sha256=sha(prep/'PRIVATE_UPLOAD_AND_DOWNLOAD_REFERENCE.json'),fresh_download_receipt_sha256=sha(fresh/'RESTORATION_RECEIPT.json'),upload_success=True,download_HTTP_status=200,file_metadata_shared=False,public_or_domain_permissions_present=False,approved_parent_matches_cached_approved_folder=True,file_owner_matches_approved_folder_owner=True,connected_profile_id_and_email_match_prior_I_profile=True,connected_profile_email_equals_Drive_owner_email=profile_matches_owner,identity_qualification='Connected app profile and Drive file/folder owner are separately observed identities; do not equate their emails or infer authenticated uploader identity/quota from ownership metadata. No private IDs, emails, URLs or locators published.',verification_scope='Independent local fresh-download/archive/inner/original byte comparison plus retained upload/get-metadata/download references. The primary executor performed the HTTP transfer; no duplicate external transfer by this verifier.',old_global_recovery_gate_cleared=False,old_missing_parts_remaining=53,quota_or_remaining_capacity_verified=False,source_coverage_limit='This small new-K bundle does not restore the older missing scientific archives or authorize larger fits.',checker_sha256=sha(Path(__file__)),new_model_fits=0,new_predictions=0,new_grades=0)
    with(HERE/'K_BUNDLE_RESTORATION_REVIEW.json').open('x')as f:json.dump(out,f,indent=2);f.write('\n')
    print(json.dumps({k:out[k]for k in('state','archive_sha256','archive_bytes','scientific_members_verified','old_global_recovery_gate_cleared','connected_profile_email_equals_Drive_owner_email')}))
if __name__=='__main__':main()
