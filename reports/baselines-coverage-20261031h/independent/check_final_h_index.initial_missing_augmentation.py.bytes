"""Independent byte-preservation, normalized source identity and CSV-index audit."""
import collections,csv,functools,gzip,hashlib,io,json,math
from pathlib import Path
ROOT=Path(__file__).resolve().parents[3];H=Path(__file__).resolve().parent.parent
def read(p):return json.loads(p.read_bytes())
def sha(b):return hashlib.sha256(b).hexdigest()
@functools.lru_cache(maxsize=2)
def sources(path):
    obj=read(ROOT/path)
    return {r['record_id']:r for r in obj}if isinstance(obj,list)else obj
def close(a,b):
    if a is None or b is None:assert a is b,(a,b)
    elif isinstance(a,str)or isinstance(b,str):assert a==b,(a,b)
    else:assert math.isclose(a,b,abs_tol=1e-12,rel_tol=1e-12),(a,b)
def main():
    path=H/'results-index-v1/INDEX_MANIFEST.json';m=read(path);old=read(ROOT/'reports/completion-20261031g/results-index-v1/INDEX_MANIFEST.json')
    assert m['shards'][:len(old['shards'])]==old['shards']and m['csv_parts'][:len(old['csv_parts'])]==old['csv_parts']
    oldparts=old['shards']+old['csv_parts']
    for b in oldparts:
        raw=(ROOT/b['path']).read_bytes();assert len(raw)==b['bytes']and sha(raw)==b['sha256']
    for b in m['input_manifests']:assert sha((ROOT/b['source_artifact']).read_bytes())==b['sha256']
    expected=read(H/'H_SCIENTIFIC_HANDOFF.json')['canonical_score_sources'];expected.append(dict(path=read(H/'probability/w5-w7-primary-p2-v1/ROOT_ADDITION_HANDOFF.json')['source_artifact'],rows=414))
    expected_counts={r['path']:r['rows']for r in expected};sourcecounts=collections.Counter();newids=[];summary={};comparison_checked=0;p2checked=0;software=0
    for b in m['shards'][len(old['shards']):]:
        raw=(ROOT/b['path']).read_bytes();assert sha(raw)==b['sha256']and len(raw)==b['bytes'];body=gzip.decompress(raw)if b.get('compression')=='gzip'else raw;assert len(body)==b['uncompressed_bytes']and sha(body)==b['uncompressed_sha256'];rr=json.loads(body);assert len(rr)==b['records']
        for r in rr:
            newids.append(r['test_id']);assert r['test_id']not in summary;source=r['source_artifact'];sourcecounts[source]+=1
            summary[r['test_id']]=(r['n'],r['primary_error'],r.get('selection_metrics'),r.get('reporting_comparison'))
            if source not in expected_counts:
                software+=1;assert 'software'in r['kind'];assert r['n']is None;continue
            s=sources(source)[r['source_record_id']];assert r['source_aggregate_fields']==s;assert r['n']==s['n']and r['category']==s['target']and r['procedure_id']==s['procedure_id']and r['history_regime']==s['history_regime']
            for metric in ('mae','mse','brier','log_loss','selection_loss_rate'):
                if metric in s:close(r['metrics'].get(metric),s[metric])
            if source.endswith('w5-w7-primary-p2-v1/SCORES.json'):
                assert r['selection_metrics']==s['selection_metrics'];assert r['fallback_rows']==s['fallback_rows']and r['side']==s['side'];p2checked+=1
            c=r.get('reporting_comparison')
            if c and c.get('status')=='PAIRED_RETAINED_ROWS'and c.get('metric')=='brier':
                assert c['paired_n']==r['n'];close(c['candidate_error'],r['metrics']['brier']);u=c['uncertainty'];close(u['delta'],c['candidate_error']-c['comparator_error']);close(u['relative_error_change'],u['delta']/c['comparator_error']if c['comparator_error']else None);comparison_checked+=1
    assert {k:sourcecounts[k]for k in expected_counts}==expected_counts
    assert len(newids)==len(set(newids))==104240 and p2checked==414 and software==2 and m['record_count']==542633
    assert old['record_count']+len(newids)==m['record_count'];csv_ids=[];csv_rows=0
    for b in m['csv_parts'][len(old['csv_parts']):]:
        raw=(ROOT/b['path']).read_bytes();assert len(raw)==b['bytes']and sha(raw)==b['sha256'];body=gzip.decompress(raw)if b.get('compression')=='gzip'else raw;count=0
        for r in csv.DictReader(io.StringIO(body.decode())):
            idx=r['test_id'];csv_ids.append(idx);n,error,selection,comparison=summary[idx];assert r['n']==(''if n is None else str(n));close(float(r['primary_error'])if r['primary_error']else None,error)
            if selection:
                for key,state in [('selection_wins','WIN'),('selection_losses','LOSS'),('selection_pushes','PUSH')]:assert int(r[key])==selection['status_counts'][state]
                close(float(r['selection_hit_rate'])if r['selection_hit_rate']else None,selection['hit_rate'])
            count+=1
        assert count==b['rows'];csv_rows+=count
    assert csv_ids==newids and csv_rows==104240
    receipt=dict(state='PASS_INDEPENDENT_H_INDEX_SOURCE_CSV_AND_PRIOR_BYTE_PRESERVATION',manifest_sha256=sha(path.read_bytes()),total_records=m['record_count'],prior_records_unchanged=old['record_count'],prior_JSON_shards_unchanged=len(old['shards']),prior_CSV_parts_unchanged=len(old['csv_parts']),new_JSON_shards=len(m['shards'])-len(old['shards']),new_CSV_parts=len(m['csv_parts'])-len(old['csv_parts']),new_records=len(newids),new_scientific_views=104238,new_software_receipts=software,H_source_arrays=len(expected_counts),P2_views_source_exact=p2checked,corrected_Brier_comparison_annotations_checked=comparison_checked,input_byte_bindings_checked=len(m['input_manifests']),all_new_CSV_rows_verified=csv_rows,new_fits=0,new_inference=0,new_grades=0)
    with (H/'independent/FINAL_H_INDEX_INDEPENDENT_REVIEW.json').open('x')as f:json.dump(receipt,f,indent=2);f.write('\n')
    print(json.dumps(receipt))
if __name__=='__main__':main()
